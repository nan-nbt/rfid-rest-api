{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IamConfig": {
    "Authority": "{issuer-open-id-configuration-url}",
    "Audience": "{aud-jwt-payload}"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host={your-host};Port={your-port};Database={your-database};Username={your-username};Password={your-password}"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5083"
      }
    }
  }  
}
