{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IamConfig": {
    "Authority": "{issuer}",
    "Audience": "{aud[2]}"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host={your-host};Port={your-port};Database={your-database};Username={your-username};Password={your-password}"
  },
  "AllowedHosts": "*"
}