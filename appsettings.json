{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IamConfig": {
    "Authority": "{open-id-configuration:issuer}",
    "Audience": "{jwt-decoded-payload:aud}"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host={your-host};Port={your-port};Database={your-database};Username={your-username};Password={your-password}"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "{your-application-host}:{your-application-port}"
      }
    }
  }  
}
